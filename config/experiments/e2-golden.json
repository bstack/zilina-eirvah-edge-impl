  "limitations": [
    "Golden synthetic samples, not a published industrial workload or measured plant data.",
    "Equivalent logical signals are intentionally replayed through every protocol; deployed station mappings are not changed.",
    "Timestamps are injected observation times; transport latency and clock synchronization are not measured.",
    "Positions and durable recovery are covered separately by E0; this replay does not exercise adapter acquisition loops.",
    "Unsigned 16-bit Modbus counters are restricted to the common signed S7 INT range for this comparison; wider counters need a declared representation.",
    "Float32 tolerance applies to numeric comparison only, never to command equality or policy thresholds. The upper bound and pre-rounding range rejection are included.",
    "Source-specific consumer is a study baseline with local mappings, not an optimized competitor or a measured integration-effort result.",
    "Source-addition effort, native/protocol faults, event interchange, broker delivery and device effects remain to be evaluated."
  ],
  "precision_contract": {
    "id": "simulated-conveyor-speed-v2",
    "unit": "m/s",
    "rounding": "half_even",
    "policy": {
      "resolution": 0.01,
      "minimum": 0.0,
      "maximum": 0.8,
      "encoding_error": 3e-08
    },
    "reason": "Common engineering resolution aligned with the selected Modbus hundredths-of-metre/second representation; range checked before rounding."
  }
