{
  "uid": "eirvah-autoscaling-v1",
  "title": "EirVah Autoscaling — uns-auto-contextualizer",
  "tags": ["eirvah", "autoscaling", "hpa"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "HPA Replica Count",
      "description": "Current and desired replicas reported by the HPA. Scale-up triggered when CPU > 60% of request. Watch current climb from 1 → N under load, then fall back to 1 after load stops.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "none",
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "max" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } },
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "min" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [4, 4] } },
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "current" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } },
              { "id": "custom.lineWidth", "value": 3 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "desired" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"eirvah-edge\",horizontalpodautoscaler=\"uns-auto-contextualizer\"}",
          "legendFormat": "current",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"eirvah-edge\",horizontalpodautoscaler=\"uns-auto-contextualizer\"}",
          "legendFormat": "desired",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"eirvah-edge\",horizontalpodautoscaler=\"uns-auto-contextualizer\"}",
          "legendFormat": "max",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
          "expr": "kube_horizontalpodautoscaler_spec_min_replicas{namespace=\"eirvah-edge\",horizontalpodautoscaler=\"uns-auto-contextualizer\"}",
          "legendFormat": "min",
          "refId": "D"
        }
      ]
    },
    {
      "id": 2,
      "title": "Current Replicas",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 9 },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "orange", "value": 4 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"eirvah-edge\",horizontalpodautoscaler=\"uns-auto-contextualizer\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Desired Replicas",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 9 },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "orange", "value": 4 }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"eirvah-edge\",horizontalpodautoscaler=\"uns-auto-contextualizer\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Scale Headroom",
      "description": "Remaining replica slots before hitting maxReplicas.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 9 },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"eirvah-edge\",horizontalpodautoscaler=\"uns-auto-contextualizer\"} - kube_horizontalpodautoscaler_status_current_replicas{namespace=\"eirvah-edge\",horizontalpodautoscaler=\"uns-auto-contextualizer\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Running Pods",
      "description": "Pods in Running phase matching uns-auto-contextualizer.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 9 },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
          "expr": "kube_deployment_status_replicas_ready{namespace=\"eirvah-edge\",deployment=\"uns-auto-contextualizer\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Handler Throughput per Pod",
      "description": "Successful contextualize ops/s broken out per pod. Under load you should see multiple pods each carrying a share of traffic — confirming the NATS queue group is distributing work across replicas.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 13 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
          "expr": "rate(eirvah_worker_handler_total{worker=\"uns-auto-contextualizer\",outcome=\"ok\"}[30s])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Total Throughput (all replicas)",
      "description": "Aggregate ops/s across all contextualizer replicas. Should stay flat under load as more pods join — demonstrating horizontal scaling maintains throughput.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 22 },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "eirvah-prometheus" },
          "expr": "sum(rate(eirvah_worker_handler_total{worker=\"uns-auto-contextualizer\",outcome=\"ok\"}[30s]))",
          "legendFormat": "total ops/s",
          "refId": "A"
        }
      ]
    }
  ]
}
